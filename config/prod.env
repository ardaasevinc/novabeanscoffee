# novabeanscoffee.com canlı ortam (k8s-01 / novabeans) — GİZLİ OLMAYAN ayarlar. Pipeline bunu ConfigMap'e çevirir.
# Değerler web-01'deki eski .env ile aynı; veritabanı ve Redis cluster'da, loglar konteyner çıktısına.
# Gizli değerler: GitLab → Settings → CI/CD → Variables → PROD_SECRETS (File, Protected).
APP_DEBUG=false
APP_ENV=production
APP_FALLBACK_LOCALE=en
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
APP_NAME=Laravel
APP_URL=https://novabeanscoffee.com
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=false
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
CACHE_PREFIX=novabeans_
CACHE_STORE=database
DB_CONNECTION=mysql
DB_DATABASE=novabeans
DB_HOST=mysql.veritabani.svc.cluster.local
DB_PORT=3306
DB_USERNAME=novabeans
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=info
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Laravel
MAIL_HOST=127.0.0.1
MAIL_MAILER=log
MAIL_PORT=2525
QUEUE_CONNECTION=database
REDIS_CACHE_DB=28
REDIS_CLIENT=phpredis
REDIS_DB=28
REDIS_HOST=redis.veritabani.svc.cluster.local
REDIS_PORT=6379
REDIS_PREFIX=novabeans_database_
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_PATH=/
VITE_APP_NAME=Laravel
