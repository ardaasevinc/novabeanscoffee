# novabeanscoffee.com canlı ortam (k8s-01 / novabeans) — GİZLİ OLMAYAN ayarlar. Pipeline bunu ConfigMap'e çevirir.
# Değerler web-01'deki eski .env ile aynı; veritabanı ve Redis cluster'da, loglar konteyner çıktısına.
# Gizli değerler: GitLab → Settings → CI/CD → Variables → PROD_SECRETS (File, Protected).
APP_DEBUG=false
APP_ENV=production
APP_FALLBACK_LOCALE=en
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
APP_NAME=Laravel
APP_URL=https://novabeanscoffee.com
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=false
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
CACHE_PREFIX=novabeans_
CACHE_STORE=database
DB_CONNECTION=mysql
DB_DATABASE=novabeans
DB_HOST=mysql.veritabani.svc.cluster.local
DB_PORT=3306
DB_USERNAME=novabeans
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=info
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Laravel
MAIL_HOST=127.0.0.1
MAIL_MAILER=log
MAIL_PORT=2525
QUEUE_CONNECTION=database
REDIS_CACHE_DB=28
REDIS_CLIENT=phpredis
REDIS_DB=28
REDIS_HOST=redis.veritabani.svc.cluster.local
REDIS_PORT=6379
REDIS_PREFIX=novabeans_database_
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_PATH=/
VITE_APP_NAME=Laravel

# Ziyaretçinin gerçek IP'si için güvenilen vekiller: Cloudflare (cloudflare.com/ips) + k3s pod ağı
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32,10.42.0.0/16
