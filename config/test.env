# novabeanstest.selquor.com test ortamı (k8s-01 / novabeans-test) — GİZLİ OLMAYAN ayarlar.
# Canlıyla aynı yapı, AYRI veritabanı (novabeans_test). Farklar: adres, veritabanı, Redis veritabanı, mail gönderilmez
# (loga yazılır); zamanlanmış işler ve kuyruk testte çalışmaz (canlı verinin kopyasıyla dış servislere istek gitmesin).
# Gizli değerler: GitLab → Settings → CI/CD → Variables → TEST_SECRETS (File).
APP_DEBUG=false
APP_ENV=production
APP_FALLBACK_LOCALE=en
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
APP_NAME=Laravel
APP_URL=https://novabeanstest.selquor.com
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=false
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
CACHE_PREFIX=novabeans_test_
CACHE_STORE=database
DB_CONNECTION=mysql
DB_DATABASE=novabeans_test
DB_HOST=mysql.veritabani.svc.cluster.local
DB_PORT=3306
DB_USERNAME=novabeans_test
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=info
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Laravel
MAIL_HOST=127.0.0.1
MAIL_MAILER=log
MAIL_PORT=2525
QUEUE_CONNECTION=database
REDIS_CACHE_DB=29
REDIS_CLIENT=phpredis
REDIS_DB=29
REDIS_HOST=redis.veritabani.svc.cluster.local
REDIS_PORT=6379
REDIS_PREFIX=novabeans_test_database_
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_PATH=/
VITE_APP_NAME=Laravel
